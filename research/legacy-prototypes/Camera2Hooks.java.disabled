package io.github.longcontroller.xposed;

import android.content.Context;
import android.graphics.ImageFormat;
import android.hardware.camera2.CaptureRequest;
import android.hardware.camera2.params.OutputConfiguration;
import android.hardware.camera2.params.SessionConfiguration;
import android.media.Image;
import android.media.ImageReader;
import android.os.Handler;
import android.os.HandlerThread;
import android.util.Size;
import android.view.Surface;

import java.util.ArrayList;
import java.util.IdentityHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.WeakHashMap;
import java.util.concurrent.atomic.AtomicBoolean;

import de.robv.android.xposed.XC_MethodHook;
import de.robv.android.xposed.XposedBridge;
import de.robv.android.xposed.XposedHelpers;

final class Camera2Hooks {
    private static final int MAX_DUMMY_OUTPUTS = 8;
    private static final AtomicBoolean INSTALLED = new AtomicBoolean(false);
    private static final Map<Surface, DummyOutput> OUTPUTS = new IdentityHashMap<>();
    private static final Map<CaptureRequest.Builder, IdentityHashMap<Surface, Surface>>
            BUILDER_TARGETS = new WeakHashMap<>();
    private static final ThreadLocal<Boolean> INTERNAL_BUILDER_CHANGE =
            ThreadLocal.withInitial(() -> false);
    private static Context appContext;
    private static ConfigGate gate;
    private static HandlerThread drainThread;
    private static Handler drainHandler;

    private Camera2Hooks() {}

    static void install(Context context, ModuleConfig config, ClassLoader targetClassLoader) {
        appContext = context.getApplicationContext();
        gate = new ConfigGate(appContext, config);
        if (!INSTALLED.compareAndSet(false, true)) return;

        drainThread = new HandlerThread("long-vcam-camera2-drain");
        drainThread.start();
        drainHandler = new Handler(drainThread.getLooper());

        hookRequestBuilder();

        try {
            Class<?> deviceImpl = XposedHelpers.findClass(
                    "android.hardware.camera2.impl.CameraDeviceImpl", targetClassLoader);
            XposedBridge.hookAllMethods(deviceImpl, "createCaptureSession", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam param) {
                    if (!gate.enabled()) return;
                    replaceSessionArguments(param.args);
                }
            });
            XposedBridge.hookAllMethods(deviceImpl, "close", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam param) {
                    closeAllOutputs();
                }
            });
        } catch (Throwable error) {
            LongCameraModule.log("Camera2 implementation hook unavailable; keeping Camera2 native");
            LongCameraModule.log(error);
        }
    }

    private static void hookRequestBuilder() {
        XposedHelpers.findAndHookMethod(
                CaptureRequest.Builder.class,
                "addTarget",
                Surface.class,
                new XC_MethodHook() {
                    @Override
                    protected void beforeHookedMethod(MethodHookParam param) {
                        if (INTERNAL_BUILDER_CHANGE.get() || !gate.enabled()) return;
                        CaptureRequest.Builder builder = (CaptureRequest.Builder) param.thisObject;
                        Surface original = (Surface) param.args[0];
                        Surface actual = mappedSurface(original);
                        synchronized (BUILDER_TARGETS) {
                            BUILDER_TARGETS.computeIfAbsent(builder, ignored -> new IdentityHashMap<>())
                                    .put(original, actual);
                        }
                        param.args[0] = actual;
                    }
                });

        XposedHelpers.findAndHookMethod(
                CaptureRequest.Builder.class,
                "removeTarget",
                Surface.class,
                new XC_MethodHook() {
                    @Override
                    protected void beforeHookedMethod(MethodHookParam param) {
                        if (INTERNAL_BUILDER_CHANGE.get() || !gate.enabled()) return;
                        CaptureRequest.Builder builder = (CaptureRequest.Builder) param.thisObject;
                        Surface original = (Surface) param.args[0];
                        synchronized (BUILDER_TARGETS) {
                            Map<Surface, Surface> targets = BUILDER_TARGETS.get(builder);
                            Surface actual = targets == null ? null : targets.remove(original);
                            if (actual != null) param.args[0] = actual;
                        }
                    }
                });

        XposedHelpers.findAndHookMethod(
                CaptureRequest.Builder.class,
                "build",
                new XC_MethodHook() {
                    @Override
                    protected void beforeHookedMethod(MethodHookParam param) {
                        if (!gate.enabled()) return;
                        remapLateTargets((CaptureRequest.Builder) param.thisObject);
                    }
                });
    }

    private static void remapLateTargets(CaptureRequest.Builder builder) {
        synchronized (BUILDER_TARGETS) {
            IdentityHashMap<Surface, Surface> targets = BUILDER_TARGETS.get(builder);
            if (targets == null || targets.isEmpty()) return;
            List<Map.Entry<Surface, Surface>> entries = new ArrayList<>(targets.entrySet());
            INTERNAL_BUILDER_CHANGE.set(true);
            try {
                for (Map.Entry<Surface, Surface> entry : entries) {
                    Surface original = entry.getKey();
                    Surface previous = entry.getValue();
                    Surface replacement = mappedSurface(original);
                    if (replacement == original || replacement == previous) continue;
                    try {
                        builder.removeTarget(previous);
                        builder.addTarget(replacement);
                        targets.put(original, replacement);
                    } catch (RuntimeException error) {
                        LongCameraModule.log("late Camera2 target mapping rejected; session will fail closed");
                    }
                }
            } finally {
                INTERNAL_BUILDER_CHANGE.set(false);
            }
        }
    }

    private static void replaceSessionArguments(Object[] args) {
        for (int index = 0; index < args.length; index++) {
            Object argument = args[index];
            if (argument instanceof SessionConfiguration configuration) {
                SessionConfiguration replacement = replaceSessionConfiguration(configuration);
                if (replacement != null) args[index] = replacement;
                return;
            }
            if (argument instanceof List<?> list && isSurfaceList(list)) {
                List<Surface> replacement = replaceSurfaceList(list);
                if (replacement != null) args[index] = replacement;
                return;
            }
        }
    }

    private static boolean isSurfaceList(List<?> list) {
        if (list.isEmpty()) return false;
        for (Object item : list) {
            if (!(item instanceof Surface)) return false;
        }
        return true;
    }

    private static List<Surface> replaceSurfaceList(List<?> originalList) {
        if (originalList.size() > MAX_DUMMY_OUTPUTS) {
            LongCameraModule.log("Camera2 output count exceeds bounded experiment budget");
            return null;
        }
        List<Surface> replacements = new ArrayList<>(originalList.size());
        List<Surface> created = new ArrayList<>();
        try {
            for (Object item : originalList) {
                Surface original = (Surface) item;
                DummyOutput output = getOrCreateOutput(original);
                if (output == null) throw new IllegalStateException("dummy output unavailable");
                replacements.add(output.surface);
                created.add(original);
            }
            for (Surface original : created) {
                VirtualMediaRenderer.start(appContext, gate.current().mediaUri, original);
            }
            return replacements;
        } catch (RuntimeException error) {
            LongCameraModule.log(error);
            return null;
        }
    }

    private static SessionConfiguration replaceSessionConfiguration(SessionConfiguration original) {
        List<OutputConfiguration> oldOutputs = original.getOutputConfigurations();
        if (oldOutputs.isEmpty()) return null;
        List<Surface> originals = new ArrayList<>();
        for (OutputConfiguration output : oldOutputs) originals.addAll(output.getSurfaces());
        if (originals.isEmpty() || originals.size() > MAX_DUMMY_OUTPUTS) return null;

        List<OutputConfiguration> newOutputs = new ArrayList<>(originals.size());
        try {
            for (Surface surface : originals) {
                DummyOutput dummy = getOrCreateOutput(surface);
                if (dummy == null) throw new IllegalStateException("dummy output unavailable");
                newOutputs.add(new OutputConfiguration(dummy.surface));
            }
            SessionConfiguration replacement = new SessionConfiguration(
                    original.getSessionType(),
                    newOutputs,
                    original.getExecutor(),
                    original.getStateCallback());
            if (original.getInputConfiguration() != null) {
                replacement.setInputConfiguration(original.getInputConfiguration());
            }
            if (original.getSessionParameters() != null) {
                replacement.setSessionParameters(original.getSessionParameters());
            }
            for (Surface surface : originals) {
                VirtualMediaRenderer.start(appContext, gate.current().mediaUri, surface);
            }
            return replacement;
        } catch (RuntimeException error) {
            LongCameraModule.log(error);
            return null;
        }
    }

    private static Surface mappedSurface(Surface original) {
        synchronized (OUTPUTS) {
            DummyOutput output = OUTPUTS.get(original);
            return output == null ? original : output.surface;
        }
    }

    private static DummyOutput getOrCreateOutput(Surface original) {
        synchronized (OUTPUTS) {
            DummyOutput existing = OUTPUTS.get(original);
            if (existing != null) return existing;
            if (OUTPUTS.size() >= MAX_DUMMY_OUTPUTS) return null;
            Size size = surfaceSize(original);
            ImageReader reader = ImageReader.newInstance(
                    size.getWidth(), size.getHeight(), ImageFormat.PRIVATE, 3);
            reader.setOnImageAvailableListener(Camera2Hooks::drainImage, drainHandler);
            DummyOutput created = new DummyOutput(reader);
            OUTPUTS.put(original, created);
            return created;
        }
    }

    private static Size surfaceSize(Surface surface) {
        try {
            Class<?> surfaceUtils = XposedHelpers.findClass(
                    "android.hardware.camera2.utils.SurfaceUtils", null);
            Object value = XposedHelpers.callStaticMethod(surfaceUtils, "getSurfaceSize", surface);
            if (value instanceof Size size && size.getWidth() > 0 && size.getHeight() > 0) {
                return size;
            }
        } catch (Throwable ignored) {
            // Hidden implementation detail varies by platform; use a conservative fallback.
        }
        return new Size(640, 480);
    }

    private static void drainImage(ImageReader reader) {
        Image image = null;
        try {
            image = reader.acquireLatestImage();
        } catch (RuntimeException error) {
            LongCameraModule.log(error);
        } finally {
            if (image != null) image.close();
        }
    }

    private static void closeAllOutputs() {
        synchronized (OUTPUTS) {
            Set<Surface> originals = Set.copyOf(OUTPUTS.keySet());
            for (Surface original : originals) {
                VirtualMediaRenderer.stop(original);
                DummyOutput output = OUTPUTS.remove(original);
                if (output != null) output.close();
            }
        }
        synchronized (BUILDER_TARGETS) {
            BUILDER_TARGETS.clear();
        }
    }

    private static final class DummyOutput {
        final ImageReader reader;
        final Surface surface;

        DummyOutput(ImageReader reader) {
            this.reader = reader;
            this.surface = reader.getSurface();
        }

        void close() {
            reader.close();
        }
    }
}
