package io.github.longcontroller.xposed;

import android.content.Context;
import android.media.MediaPlayer;
import android.net.Uri;
import android.view.Surface;

import java.util.IdentityHashMap;
import java.util.Map;

final class VirtualMediaRenderer {
    private static final int MAX_ACTIVE_PLAYERS = 4;
    private static final Map<Surface, MediaPlayer> PLAYERS = new IdentityHashMap<>();

    private VirtualMediaRenderer() {}

    static synchronized boolean start(Context context, Uri mediaUri, Surface surface) {
        if (surface == null || !surface.isValid()) return false;
        if (PLAYERS.containsKey(surface)) return true;
        if (PLAYERS.size() >= MAX_ACTIVE_PLAYERS) {
            LongCameraModule.log("renderer budget exhausted; keeping this output native/closed");
            return false;
        }
        MediaPlayer player = new MediaPlayer();
        try {
            player.setDataSource(context, mediaUri);
            player.setSurface(surface);
            player.setLooping(true);
            player.setVolume(0f, 0f);
            player.setOnPreparedListener(MediaPlayer::start);
            player.setOnErrorListener((failed, what, extra) -> {
                LongCameraModule.log("media output rejected what=" + what + " extra=" + extra);
                stop(surface);
                return true;
            });
            PLAYERS.put(surface, player);
            player.prepareAsync();
            return true;
        } catch (Exception error) {
            PLAYERS.remove(surface);
            try {
                player.release();
            } catch (RuntimeException ignored) {
                // Best-effort release after setup failure.
            }
            LongCameraModule.log(error);
            return false;
        }
    }

    static synchronized void stop(Surface surface) {
        MediaPlayer player = PLAYERS.remove(surface);
        if (player == null) return;
        try {
            player.stop();
        } catch (RuntimeException ignored) {
            // A player can fail before reaching PREPARED.
        }
        player.reset();
        player.release();
    }

    static synchronized void stopAll() {
        Surface[] surfaces = PLAYERS.keySet().toArray(new Surface[0]);
        for (Surface surface : surfaces) stop(surface);
    }
}
