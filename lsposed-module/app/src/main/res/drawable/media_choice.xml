<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <corners android:radius="@dimen/corner_control" />
                    <solid android:color="@color/accent_tonal" />
                    <stroke android:width="1dp" android:color="@color/accent" />
                </shape>
            </item>
            <item android:drawable="@drawable/card_background" />
        </selector>
    </item>
</ripple>
