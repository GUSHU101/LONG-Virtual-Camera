<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:background="@color/surface_card"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_small">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/studio_mark"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_small">
            <TextView
                style="@style/SectionTitle"
                android:text="@string/studio_brand" />
            <TextView
                style="@style/CaptionText"
                android:text="@string/studio_label" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/theme_action"
            style="@style/StudioIconButton"
            android:contentDescription="@string/theme_action"
            android:src="@drawable/ic_studio_theme" />
        <ImageButton
            android:id="@+id/header_stop_button"
            style="@style/StudioIconButton"
            android:contentDescription="@string/stop_all"
            android:src="@drawable/ic_studio_stop"
            android:tint="@color/error"
            android:layout_marginStart="4dp" />
    </LinearLayout>
    <View
        style="@style/Separator" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <include
            layout="@layout/studio_workbench" />
        <include
            layout="@layout/studio_media" />
        <include
            layout="@layout/studio_monitor" />
        <include
            layout="@layout/studio_settings" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:id="@+id/feedback_banner"
        android:background="@color/surface_subtle"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/feedback_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/space_small"
            android:importantForAccessibility="no"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
        <TextView
            android:id="@+id/feedback_text"
            style="@style/BodyText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="@dimen/space_small"
            android:paddingBottom="@dimen/space_small" />
        <Button
            android:id="@+id/feedback_details"
            style="@style/ActionButton"
            android:text="@string/view_operation_details"
            android:layout_width="wrap_content"
            android:textColor="@color/accent_ink" />
    </LinearLayout>
    <View
        style="@style/Separator" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:id="@+id/studio_navigation"
        android:minHeight="@dimen/bottom_bar"
        android:background="@color/surface_card"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_small">
        <Button
            android:id="@+id/nav_control"
            style="@style/NavButton"
            android:text="@string/nav_control"
            android:drawableTop="@drawable/ic_studio_workbench"
            android:drawableTint="@color/tab_label"
            android:drawablePadding="3dp" />
        <Button
            android:id="@+id/nav_sources"
            style="@style/NavButton"
            android:text="@string/nav_sources"
            android:drawableTop="@drawable/ic_studio_media"
            android:drawableTint="@color/tab_label"
            android:drawablePadding="3dp" />
        <Button
            android:id="@+id/nav_diagnostics"
            style="@style/NavButton"
            android:text="@string/nav_diagnostics"
            android:drawableTop="@drawable/ic_studio_monitor"
            android:drawableTint="@color/tab_label"
            android:drawablePadding="3dp" />
        <Button
            android:id="@+id/nav_settings"
            style="@style/NavButton"
            android:text="@string/nav_settings"
            android:drawableTop="@drawable/ic_studio_settings"
            android:drawableTint="@color/tab_label"
            android:drawablePadding="3dp" />
    </LinearLayout>
</LinearLayout>
