<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="4dp">

        <TextView
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <Button
            android:id="@+id/refresh_button"
            style="@style/ActionButton"
            android:layout_width="wrap_content"
            android:text="@string/refresh" />
    </LinearLayout>
    <View style="@style/Separator" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/control_page"
            style="@style/Page"
            tools:targetApi="28"
            android:accessibilityPaneTitle="@string/nav_control">
            <LinearLayout style="@style/PageContent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hero_background"
                    android:orientation="vertical"
                    android:padding="@dimen/panel_padding">

                    <TextView
                        style="@style/PageTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/control_heading"
                        android:textColor="@color/hero_ink" />
                    <TextView
                        android:id="@+id/overview_state"
                        style="@style/SectionTitle"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/overview_unknown"
                        android:textColor="@color/hero_ink" />
                    <TextView
                        android:id="@+id/overview_source"
                        style="@style/BodyText"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/hero_muted" />
                    <Button
                        android:id="@+id/overview_action"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/space_medium"
                        android:text="@string/view_diagnostics" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/outputs_heading" />

                    <Switch
                        android:id="@+id/camera_switch"
                        style="@style/ControlSwitch"
                        android:text="@string/global_camera" />
                    <TextView
                        android:id="@+id/camera_status"
                        style="@style/BodyText"
                        android:paddingBottom="@dimen/space_small"
                        android:text="@string/overview_unknown" />
                    <View style="@style/Separator" />

                    <Switch
                        android:id="@+id/photo_switch"
                        style="@style/ControlSwitch"
                        android:text="@string/photo_replace" />
                    <TextView
                        android:id="@+id/photo_status"
                        style="@style/BodyText"
                        android:paddingBottom="@dimen/space_small"
                        android:text="@string/overview_unknown" />
                    <View style="@style/Separator" />

                    <Switch
                        android:id="@+id/mic_switch"
                        style="@style/ControlSwitch"
                        android:text="@string/microphone_replace" />
                    <TextView
                        android:id="@+id/mic_status"
                        style="@style/BodyText"
                        android:text="@string/microphone_replace_hint" />
                </LinearLayout>

                <Button
                    android:id="@+id/stop_button"
                    style="@style/ActionButton"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/stop_all"
                    android:textColor="@color/warning" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/source_page"
            style="@style/Page"
            tools:targetApi="28"
            android:accessibilityPaneTitle="@string/nav_sources"
            android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView
                    style="@style/PageTitle"
                    tools:targetApi="28"
                    android:accessibilityHeading="true"
                    android:text="@string/source_title" />

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/current_source" />
                    <TextView
                        android:id="@+id/source_status"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/overview_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/local_media" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_small"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/select_video_button"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/select_video" />
                        <Button
                            android:id="@+id/select_image_button"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_small"
                            android:layout_weight="1"
                            android:text="@string/select_image" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/select_audio_button"
                        style="@style/ActionButton"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/select_audio" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/obs_title" />
                    <TextView
                        android:id="@+id/obs_configuration"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:background="@drawable/status_background"
                        android:padding="@dimen/space_small"
                        android:text="@string/obs_status_unknown" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_medium"
                        android:labelFor="@+id/obs_connection_input"
                        android:text="@string/obs_url_label" />
                    <EditText
                        android:id="@id/obs_connection_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone|flagNoExtractUi|flagNoPersonalizedLearning"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/obs_address_guidance"
                        style="@style/BodyText"
                        android:text="@string/obs_url_hint" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_marginTop="4dp"
                        android:text="@string/obs_hint" />
                    <Switch
                        android:id="@+id/obs_audio_switch"
                        style="@style/ControlSwitch"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/obs_audio_opt_in" />
                    <Button
                        android:id="@+id/configure_obs_button"
                        style="@style/PrimaryButton"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/configure_obs" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/diagnostics_page"
            style="@style/Page"
            tools:targetApi="28"
            android:accessibilityPaneTitle="@string/nav_diagnostics"
            android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView
                    style="@style/PageTitle"
                    tools:targetApi="28"
                    android:accessibilityHeading="true"
                    android:text="@string/status_title" />

                <LinearLayout android:id="@+id/operation_card" style="@style/Card" android:visibility="gone">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/operation_details_title" />
                    <TextView
                        android:id="@+id/operation_log"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/runtime_heading" />
                    <TextView
                        android:id="@+id/status_updated"
                        style="@style/BodyText"
                        android:layout_marginTop="4dp"
                        android:text="@string/status_not_read" />
                    <TextView
                        android:id="@+id/runtime_details"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/overview_unknown"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/root_title" />
                    <TextView
                        android:id="@+id/root_status"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/root_not_checked" />
                    <Button
                        android:id="@+id/root_button"
                        style="@style/SecondaryButton"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/root_button" />
                    <Button
                        android:id="@+id/install_button"
                        style="@style/ActionButton"
                        android:text="@string/install_button" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/SectionTitle"
                        tools:targetApi="28"
                        android:accessibilityHeading="true"
                        android:text="@string/scope_title" />
                    <TextView
                        android:id="@+id/framework_status"
                        style="@style/BodyText"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/framework_checking"
                        android:textIsSelectable="true" />
                    <Button
                        android:id="@+id/scope_button"
                        style="@style/SecondaryButton"
                        android:layout_marginTop="@dimen/space_small"
                        android:text="@string/scope_button" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/feedback_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_subtle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/feedback_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/space_small"
            android:importantForAccessibility="no"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
        <TextView
            android:id="@+id/feedback_text"
            style="@style/BodyText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="@dimen/space_small"
            android:paddingBottom="@dimen/space_small" />
        <Button
            android:id="@+id/feedback_details"
            style="@style/ActionButton"
            android:layout_width="wrap_content"
            android:text="@string/view_operation_details" />
    </LinearLayout>
    <View style="@style/Separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="4dp">
        <Button
            android:id="@+id/nav_control"
            style="@style/NavButton"
            android:text="@string/nav_control" />
        <Button
            android:id="@+id/nav_sources"
            style="@style/NavButton"
            android:layout_marginStart="@dimen/space_small"
            android:text="@string/nav_sources" />
        <Button
            android:id="@+id/nav_diagnostics"
            style="@style/NavButton"
            android:layout_marginStart="@dimen/space_small"
            android:text="@string/nav_diagnostics" />
    </LinearLayout>
</LinearLayout>
