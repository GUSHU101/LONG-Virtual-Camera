<resources>
    <string name="app_name">LONG Virtual Camera</string>
    <string name="app_description">system 作用域 LSPosed 模块与 Root 全局虚拟相机控制面板</string>
    <string name="title">LONG Virtual Camera</string>
    <string name="subtitle">一个 system 作用域 · 一条全局原生替换链路</string>
    <string name="scope_title">LSPosed 系统层</string>
    <string name="scope_hint">作用域只需勾选 system，不需要勾选任何单独 App。system 负责模块激活；所有 App 的相机调用统一由 cameraserver 原生链路处理。</string>
    <string name="scope_button">仅申请 system 作用域</string>
    <string name="root_title">Root 控制平面</string>
    <string name="root_not_checked">Root：尚未检查</string>
    <string name="root_button">请求 / 检查 Root</string>
    <string name="install_button">校验并安装载荷</string>
    <string name="source_title">手机端媒体源</string>
    <string name="source_hint">本地文件和 OBS 都进入同一套原生解码、共享内存与系统服务 hook；它们只是输入来源，不是两套替换模式。</string>
    <string name="source_not_configured">尚未配置输入源</string>
    <string name="source_independent_status">画面来源：%1$s\n麦克风替换来源：%2$s</string>
    <string name="select_video">选择本地视频</string>
    <string name="select_image">选择本地图片</string>
    <string name="select_audio">选择本地音频（可选麦克风源）</string>
    <string name="obs_title">OBS 直播输入</string>
    <string name="obs_hint">生成随机推流密钥并在手机 1935 端口接收 H.264 + AAC。默认只监听本机回环并通过 adb forward 走 USB。</string>
    <string name="obs_lan_opt_in">允许可信局域网连接（扩大网络暴露面）</string>
    <string name="obs_not_configured">尚未启用 OBS 输入</string>
    <string name="configure_obs">启用 OBS / 重新生成密钥</string>
    <string name="copy_obs">复制 OBS 服务器与推流密钥</string>
    <string name="global_camera">全局摄像头替换</string>
    <string name="global_camera_hint">开启后注入唯一 cameraserver 链路，系统 CameraService 的所有客户端共享替换结果。</string>
    <string name="photo_replace">照片输出替换</string>
    <string name="photo_replace_hint">与全局相机共享同一个视频 feeder 和 hook，不启动第二套引擎。</string>
    <string name="microphone_replace">虚拟麦克风（可选）</string>
    <string name="microphone_replace_hint">默认关闭。关闭时不运行 PCM feeder、不保留音频 hook，直接使用手机自带麦克风。</string>
    <string name="stop_all">停止全部并恢复系统服务</string>
    <string name="refresh">刷新状态</string>
    <string name="status_title">实时状态</string>
    <string name="initial_log">尚未执行操作。请先在 LSPosed 中启用模块并只勾选 system，然后重启手机。</string>
    <string name="source_notice">本项目运行时只有手机端 LSPosed 模块 APK。电脑端无需安装 LONG 客户端；使用直播时，OBS 直接向手机推送 RTMP。</string>
    <string name="authorized_notice">仅用于你拥有或明确获准测试的设备。系统服务注入存在固件兼容风险，请先备份并保留可恢复环境。</string>
