<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LongVirtualCamera.Platform" parent="android:style/Theme.Material.Light.NoActionBar" />

    <style name="Theme.LongVirtualCamera" parent="Theme.LongVirtualCamera.Platform">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>

    <style name="PageContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/page_gutter</item>
        <item name="android:paddingEnd">@dimen/page_gutter</item>
        <item name="android:paddingTop">@dimen/space_medium</item>
        <item name="android:paddingBottom">@dimen/space_medium</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">@dimen/space_medium</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">@dimen/panel_padding</item>
    </style>

    <style name="PageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="ControlSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:switchPadding">@dimen/space_small</item>
        <item name="android:textColor">@color/control_label</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_small</item>
        <item name="android:paddingEnd">@dimen/space_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/control_label</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PrimaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/primary_label</item>
    </style>

    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_tonal</item>
        <item name="android:textColor">@color/tonal_label</item>
    </style>

    <style name="NavButton" parent="ActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_tab</item>
        <item name="android:textColor">@color/tab_label</item>
    </style>

    <style name="Separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
